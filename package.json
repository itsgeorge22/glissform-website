{
  "name": "glissform-website",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/optimize-assets.mjs",
    "prebuild": "node scripts/optimize-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/compress-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:future-field": "node --experimental-strip-types --test tests/future-field.test.mjs",
    "generate:future-field": "node --experimental-strip-types scripts/render-future-field.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "gsap": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "sass": "^1.93.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}

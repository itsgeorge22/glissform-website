{
  "name": "glissform-homepage-next",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/optimize-assets.mjs && node scripts/generate-social-image.mjs",
    "prebuild": "node scripts/optimize-assets.mjs && node scripts/generate-social-image.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 NODE_ENV=development astro dev --host 127.0.0.1 --port 5180",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/compress-assets.mjs",
    "build:v2": "DEPLOY_V2=1 npm run build",
    "deploy:v2": "bash scripts/deploy-v2.sh",
    "preview": "astro preview --host 127.0.0.1 --port 4180",
    "test:deploy": "python3 -m unittest discover -s tests -p 'deploy*_test.py'",
    "test:deploy:v2": "DEPLOY_V2=1 npm run test:deploy",
    "generate:future-field": "node --experimental-strip-types scripts/render-future-field.mjs",
    "check": "astro check",
    "dev:legacy": "vite --host 127.0.0.1 --port 5181",
    "build:legacy": "tsc --noEmit && node scripts/build.mjs",
    "prepare:model": "node scripts/prepare-macbook-model.mjs && node scripts/prepare-macbook-details.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@fontsource/inter": "^5.2.8",
    "astro": "7.3.5",
    "gsap": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "gltfpack": "1.3.0",
    "sass": "^1.93.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "8.3.2"
  }
}

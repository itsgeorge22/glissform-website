{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.glissform.app"
        }
      ],
      "destination": "https://glissform.app/:path*",
      "statusCode": 301
    },
    {
      "source": "/downloads/Glissform-0.1.0.dmg",
      "destination": "https://github.com/itsgeorge22/glissform/releases/download/v0.1.0/Glissform-0.1.0.dmg",
      "statusCode": 302
    },
    {
      "source": "/downloads/Glissform-0.1.0.dmg.sha256",

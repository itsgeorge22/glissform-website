---
import './analytics-consent.scss';
---
<aside class="analytics-consent" aria-labelledby="analytics-consent-title" hidden>
  <div>
    <strong id="analytics-consent-title">Help improve Glissform</strong>
    <p>Help make Glissform better by sharing basic usage statistics, like page visits and download clicks. It’s optional, and you can change your choice anytime.</p>
  </div>
  <div class="analytics-consent__actions">
    <button type="button" data-analytics-choice="accepted">Allow</button>
    <a class="analytics-consent__details" href="/privacy/#website-analytics">Read More</a>
    <button class="analytics-consent__decline" type="button" data-analytics-choice="declined">No thanks</button>
  </div>
</aside>
<script>
  import { analyticsChoice, chooseAnalytics, startAnalytics } from './analytics';
  import { springDisplacement } from './home-next/objectMotion';
  const banner = document.querySelector<HTMLElement>('.analytics-consent');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let animation: Animation | undefined;
  let visible = false;
  let opener: HTMLElement | undefined;
  const settle = () => {
    if (banner) banner.hidden = !visible;
    animation?.cancel();
    animation = undefined;
  };
  const reveal = (show: boolean, delay = 0) => {
    if (!banner) return;
    if (visible === show) {
      // A settings click also skips an automatic entrance that is still waiting.
      if (show && delay === 0 && animation) {
        const pendingDelay = animation.effect?.getTiming().delay ?? 0;
        if (typeof animation.currentTime === 'number' && animation.currentTime < pendingDelay) {
          animation.currentTime = pendingDelay;
        }
      }
      return;
    }
    const wasHidden = banner.hidden;
    const current = getComputedStyle(banner);
    const opacity = wasHidden ? 0 : Number(current.opacity);
    const y = wasHidden ? 24 : new DOMMatrixReadOnly(current.transform).m42;
    animation?.cancel();
    visible = show;
    banner.hidden = false;
    banner.inert = !show;
    if (!show && banner.contains(document.activeElement)) {
      if (opener?.isConnected) opener.focus({ preventScroll: true });
      else (document.activeElement as HTMLElement)?.blur();
    }
    if (motion.matches) { settle(); return; }
    const frames = show
      ? Array.from({ length: 41 }, (_, index) => {
          const progress = index / 40;
          return { offset: progress,
            opacity: opacity + (1 - opacity) * Math.min(1, progress * 2),
            transform: `translateY(${y * springDisplacement(progress, 9, 10)}px)` };
        })
      : [{ opacity, transform: `translateY(${y}px)` }, { opacity: 0, transform: `translateY(${y}px)` }];
    animation = banner.animate(frames, {
      duration: show ? 600 : 180, delay: show ? delay : 0,
      easing: show ? 'linear' : 'ease-out', fill: 'both',
    });
    animation.onfinish = settle;
  };
  motion.addEventListener('change', settle);
  window.addEventListener('pagehide', settle);
  const update = () => reveal(analyticsChoice() === 'undecided', 500);
  update();
  startAnalytics();
  window.addEventListener('glissform:analytics-choice', update);
  document.addEventListener('click', event => {
    const target = event.target as Element | null;
    const choice = target?.closest<HTMLButtonElement>('[data-analytics-choice]')?.dataset.analyticsChoice;
    if (choice === 'accepted' || choice === 'declined') {
      chooseAnalytics(choice);
      // When storage is blocked, dismiss for this page and keep analytics off.
      reveal(false);
    }
    if (target?.closest('[data-analytics-settings]') && banner) {
      event.preventDefault();
      opener = target.closest<HTMLElement>('[data-analytics-settings]') ?? undefined;
      reveal(true);
      banner.querySelector('button')?.focus({ preventScroll: true });
    }
  });
</script>

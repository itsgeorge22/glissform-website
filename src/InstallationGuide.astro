---
import { downloadUrl, siteUrl } from './siteMetadata';
import './installation-guide.scss';
import { updateArrowPath, updateShelfPath } from './home-next/stayUpdatedIcon';

const steps = ['Move to Applications', 'Open Glissform', 'Allow it in Settings', 'Confirm and open'];
---

<glissform-installation-guide>
  <dialog class="installation-guide" aria-labelledby="installation-guide-title" aria-describedby="installation-guide-description">
    <div class="installation-guide__backdrop" aria-hidden="true"></div>
    <div class="installation-guide__panel">
      <header class="installation-guide__header">
        <button class="installation-guide__close" type="button" data-installation-close aria-label="Close installation guide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
        </button>
        <h2 id="installation-guide-title" tabindex="-1">Get started with Glissform</h2>
        <p id="installation-guide-description">A few simple steps to open Glissform on your Mac.</p>
      </header>

      <div class="installation-guide__body" tabindex="0" role="region" aria-label="Installation steps">
        <ol class="installation-guide__steps">
          {steps.map((title, index) => <li class="installation-guide__step">
            <h3>{index + 1}. {title}</h3>
            {index === 0 && <p>Open the downloaded <strong>.dmg</strong> file, then drag the Glissform app into the <strong>Applications</strong> folder to install it.</p>}
            {index === 1 && <p>Launch Glissform from your Applications folder. If macOS displays a security alert, click <strong>Done</strong> to close it.</p>}
            {index === 2 && <p>Go to <strong>System Settings → Privacy &amp; Security</strong>, then scroll down to the Glissform message and click <strong>Open Anyway</strong>.</p>}
            {index === 3 && <p>Confirm your choice using <strong>Touch ID or your password</strong>. When macOS asks again, click <strong>Open</strong> to launch Glissform.</p>}
          </li>)}
        </ol>
        <aside class="installation-guide__note">
          <p>This release candidate isn’t Apple notarized yet, so macOS asks for your approval before the first launch. <a href="https://support.apple.com/en-gb/102445" target="_blank" rel="noopener noreferrer">About this step<span class="installation-guide__sr-only"> (opens in a new tab)</span></a></p>
        </aside>
      </div>

      <footer class="installation-guide__footer">
        <a class="installation-guide__retry" href={new URL(downloadUrl, siteUrl).href} data-installation-download>
          <svg width="18" height="18" viewBox="0 0 38.5542 38.5542" fill="currentColor" aria-hidden="true"><path d={updateArrowPath} fill-rule="evenodd" /><path d={updateShelfPath} fill-rule="evenodd" /></svg>
          Download again
        </a>
        <button class="installation-guide__done" type="button" data-installation-close>Got it</button>
      </footer>
    </div>
  </dialog>
</glissform-installation-guide>

<script>
  import { setupInstallationGuide } from './installationGuide';

  class GlissformInstallationGuide extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const dialog = this.querySelector('dialog');
      if (dialog) this.cleanup = setupInstallationGuide(dialog);
    }

    disconnectedCallback() { this.cleanup?.(); }
  }

  if (!customElements.get('glissform-installation-guide')) {
    customElements.define('glissform-installation-guide', GlissformInstallationGuide);
  }
</script>

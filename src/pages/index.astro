---
import Hero from '../home-next/Hero';
import FaqSection from '../home-next/FaqSection';
import PrivacySection from '../home-next/PrivacySection';
import SeamlessCloseFeatures from '../home-next/SeamlessCloseFeatures';
import SettingsFeatures from '../home-next/SettingsFeatures';
import { designReferenceWidth } from '../home-next/designScale';
import '../home-next/home-ending.scss';
import favicon from '../generated/assets/favicon.png?url';
import { siteUrl, siteTitle, siteDescription, socialTitle, socialDescription, socialImage, softwareApplication } from '../siteMetadata';
---
<!doctype html>
<html lang="en" class="home-next-page no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      // Restore native behavior, including history entries made by older previews.
      if ('scrollRestoration' in history) history.scrollRestoration = 'auto';
      // Older navbar links left fragments behind. On reload/history traversal,
      // remove them before anchor scrolling can override the saved position.
      const navigationType = performance.getEntriesByType('navigation')[0]?.type;
      if ((navigationType === 'reload' || navigationType === 'back_forward') &&
          ['#how-it-works', '#seamless-close-features', '#good-to-know', '#privacy'].includes(location.hash)) {
        history.replaceState(history.state, '', location.pathname + location.search);
      }
    </script>
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content={import.meta.env.DEV ? 'noindex, nofollow' : 'index, follow'} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/png" sizes="64x64" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Glissform" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplication)} />
  </head>
  <body class="home-next" style={`--design-reference-width: ${designReferenceWidth}`}>
    <a class="home-next__skip" href="#how-it-works">Skip to features</a>
    <main>
      <Hero client:load />
      <SettingsFeatures client:load />
      <PrivacySection />
      <div class="home-ending">
        <div class="home-ending__customization" id="seamless-close-features">
          <SeamlessCloseFeatures client:load />
        </div>
        <FaqSection client:load />
      </div>
    </main>
    <script>
      if (import.meta.env.DEV && new URLSearchParams(location.search).has('profile')) {
        import('../hero-test-animation/frameProbe').then(({ mountFrameProbe }) => mountFrameProbe());
      }
    </script>
  </body>
</html>
